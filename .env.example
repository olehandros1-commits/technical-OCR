# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Cost control ---------------------------------------------------
# Demo replay: zero-cost playback of a saved snapshot. Flip to 1 for
# live demos / screen recordings so no API spend happens.
# EXTRACTOR_DEMO_REPLAY=0
# EXTRACTOR_DEMO_REPLAY_FILE=out/ixonia_extraction.json

# ---- Per-role models ------------------------------------------------
# Defaults are cost-conscious: Haiku for cheap roles, Sonnet for
# extraction + repair, Opus opt-in only.
# ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
# ANTHROPIC_MODEL_EXTRACT=claude-sonnet-4-5
# ANTHROPIC_MODEL_REPAIR=claude-sonnet-4-5
# ANTHROPIC_MODEL_VISION=claude-sonnet-4-5

# ---- Local LLM (Ollama) --------------------------------------------
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL_CHEAP=qwen2.5:7b
# OLLAMA_MODEL_EXTRACT=qwen2.5:14b
# OLLAMA_MODEL_REPAIR=qwen2.5:14b

# ---- Backend pick ---------------------------------------------------
# EXTRACTOR_BACKEND=anthropic    # or 'ollama'

# ---- Output cap -----------------------------------------------------
# EXTRACTOR_MAX_TOKENS=16000
