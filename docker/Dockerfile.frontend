# Production frontend image: build with Vite, serve via nginx.
# Build: docker compose build ui  (recommended)
# We use plain `npm` not pnpm in the container because node:20-alpine
# doesn't ship corepack-bundled pnpm reliably across registries.
FROM node:20-alpine AS build
WORKDIR /app

# Copy manifest first so the dep layer caches.
COPY package.json ./
# Lockfile is optional -- npm will resolve from package.json if absent.
COPY package-lock.json* ./

RUN npm install --no-audit --no-fund

COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
