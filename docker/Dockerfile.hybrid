FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      libgl1 libglib2.0-0 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "opendataloader-pdf[hybrid]>=2.4.3"

RUN python -c "import easyocr; easyocr.Reader(['en'], gpu=False, download_enabled=True)"

ENV PYTHONUNBUFFERED=1
EXPOSE 5002

CMD ["opendataloader-pdf-hybrid", "--host", "0.0.0.0", "--port", "5002", "--device", "cpu", "--ocr-lang", "en"]
