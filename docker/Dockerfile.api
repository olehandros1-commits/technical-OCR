FROM ghcr.io/astral-sh/uv:0.5-python3.12-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      tesseract-ocr poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/

ENV UV_LINK_MODE=copy
RUN uv sync --frozen --no-dev \
    --extra ocr --extra redis --extra ollama --extra queue \
    --extra otel --extra metrics --extra sentry

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV EXTRACTOR_CORS_ALLOW=*

EXPOSE 8000

CMD ["uvicorn", "dobs.api:app", "--host", "0.0.0.0", "--port", "8000"]
